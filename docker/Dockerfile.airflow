# =============================================================================
# Airflow image.
#
# Airflow submits the batch job to the standalone Spark cluster in client deploy
# mode, so this image needs a JRE, spark-submit and the same connector JARs as
# the cluster. It gets them the same way the Spark image does -- from the pyspark
# wheel plus pinned Maven artefacts -- so driver and executors run identical
# versions.
# =============================================================================
FROM apache/airflow:2.10.3-python3.11

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        gpg \
        ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public \
        | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" \
        > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        temurin-17-jre \
        curl \
        procps \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/temurin-17-jre-amd64

USER airflow

# pyspark is installed without the Airflow constraint file so the version matches
# the cluster exactly. The Spark provider gives Airflow its Spark connection type.
RUN pip install --no-cache-dir \
        pyspark==3.5.1 \
        apache-airflow-providers-apache-spark==4.11.1 \
        confluent-kafka==2.5.3 \
        boto3==1.35.36 \
        "psycopg[binary]==3.2.3" \
        prometheus-client==0.21.0

ENV SPARK_HOME=/home/airflow/.local/lib/python3.11/site-packages/pyspark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}" \
    PYTHONPATH=/opt/pipeline

ARG MAVEN=https://repo.maven.apache.org/maven2
RUN set -eux; \
    for jar in \
      "org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.1/spark-sql-kafka-0-10_2.12-3.5.1.jar" \
      "org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.1/spark-token-provider-kafka-0-10_2.12-3.5.1.jar" \
      "org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar" \
      "org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar" \
      "org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar" \
      "org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar" \
    ; do \
      curl -fL --http1.1 --retry 5 --retry-delay 3 --retry-all-errors \
        -o "${SPARK_HOME}/jars/$(basename "$jar")" "${MAVEN}/${jar}"; \
    done; \
    path="com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar"; \
    out="${SPARK_HOME}/jars/aws-java-sdk-bundle-1.12.262.jar"; \
    curl -fL --http1.1 -C - --retry 20 --retry-delay 5 --retry-all-errors \
      --connect-timeout 30 \
      -o "$out" "${MAVEN}/${path}"; \
    expected="$(curl -fsSL --http1.1 "${MAVEN}/${path}.sha1" | cut -d' ' -f1)"; \
    echo "${expected}  ${out}" | sha1sum -c -; \
    test -x "${SPARK_HOME}/bin/spark-submit"
