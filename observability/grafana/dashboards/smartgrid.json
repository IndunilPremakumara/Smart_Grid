{
  "id": null,
  "uid": "smartgrid-pipeline",
  "title": "Smart Grid Lambda Pipeline",
  "tags": ["smartgrid", "lambda", "kafka", "spark"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Zone Load (kWh) — Speed Layer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "grid_zone_load_kwh",
          "legendFormat": "{{grid_zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "kwatth", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "Renewable Contribution % per Zone",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "grid_zone_renewable_pct",
          "legendFormat": "{{grid_zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Meters per Zone",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "grid_active_meters",
          "legendFormat": "{{grid_zone}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" }
    },
    {
      "id": 4,
      "title": "Records Produced (stream)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(grid_records_total{component='stream-producer',outcome='produced'}[5m])",
          "legendFormat": "produced/5m",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "title": "Pipeline Errors (all stages)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(grid_errors_total[2m])",
          "legendFormat": "{{component}} / {{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },
    {
      "id": 6,
      "title": "Business Alerts Raised",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(grid_alerts_raised_total[5m])",
          "legendFormat": "{{alert_type}} / {{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "Simulated Day Index",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "grid_sim_day_index{component='stream-producer'}",
          "legendFormat": "sim day",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "title": "Pipeline Staleness (seconds since last write)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "time() - grid_last_record_unixtime",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "title": "Micro-batch Duration (speed layer)",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 18 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(grid_operation_duration_seconds_bucket{component='speed-layer'}[5m]))",
          "legendFormat": "p95 {{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 10,
      "title": "API Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 18 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(grid_operation_duration_seconds_bucket{component='serving-api'}[5m]))",
          "legendFormat": "p95 http_request",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
